<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.CAMERA"
        tools:ignore="ManifestOrder,PermissionImpliesUnsupportedChromeOsHardware" />
    <uses-feature
        android:name="android.hardware.camera.flash"
        android:required="false" />

    <application
        android:name="com.example.flashlight.App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Flashlight"
        tools:replace="android:fullBackupContent,android:dataExtractionRules">

        <!-- AdMob Application ID -->
        <meta-data
            android:name="com.google.android.gms.ads.APPLICATION_ID"
            android:value="${ad_app_id}" />

        <!-- Facebook SDK Meta Data -->
        <meta-data
            android:name="com.facebook.sdk.ApplicationId"
            android:value="${facebookAppId}" />
        <meta-data
            android:name="com.facebook.sdk.ClientToken"
            android:value="${facebookClientToken}" />

        <activity
            android:name="com.example.flashlight.component.splash.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Flashlight.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.example.flashlight.component.onboard.OnboardingActivity"
            android:exported="false" />

        <activity
            android:name="com.example.flashlight.component.onboard.IntroActivity"
            android:exported="false" />

        <activity
            android:name="com.example.flashlight.component.language.LanguageActivity"
            android:exported="false" />

        <activity
            android:name="com.example.flashlight.component.main.MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden"
            android:exported="false" />
    </application>

</manifest>