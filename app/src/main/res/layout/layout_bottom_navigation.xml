<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <!-- 5. Custom Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/layoutBottomNav"
        android:layout_width="match_parent"
        android:layout_height="87dp"
        android:background="@drawable/bg_navigation"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:weightSum="4"
        tools:ignore="MissingConstraints">

        <!-- Item 1: Flashlight -->
        <LinearLayout
            android:id="@+id/btnNavFlashlight"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_flash_navigation"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavFlashlight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_navigation_flash"
                app:tint="@color/bg_yellow_switch" />

            <TextView
                android:id="@+id/tvNavFlashlight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Flashlight"
                android:textColor="@color/bg_yellow_switch"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Item 2: Edge Lighting / Screen Light -->
        <LinearLayout
            android:id="@+id/btnNavScreenLight"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavScreenLight"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_navigation_edge"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvNavScreenLight"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Edge Lighting"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Item 3: LED -->
        <LinearLayout
            android:id="@+id/btnNavLed"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavLed"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_navigation_led"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvNavLed"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="LED"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Item 4: Settings / Flash Alert -->
        <LinearLayout
            android:id="@+id/btnNavSettings"
            android:layout_width="0dp"
            android:layout_height="67dp"
            android:layout_weight="1"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivNavSettings"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_navigation_flash_alert"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:text="Flash Alert"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
