<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center|top"
    android:background="#111111"
    android:paddingBottom="4dp">

    <!-- Hero Image takes remaining weight to automatically expand when ad is hidden -->
    <ImageView
        android:id="@+id/imgHero"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scaleType="centerCrop"
        android:src="@drawable/bg_onb1"
        android:contentDescription="Onboarding illustration" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:text="@string/onb_title_1"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:gravity="center" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="4dp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:text="@string/onb_desc_1"
        android:textColor="#BDBDBD"
        android:textSize="12sp" />

</LinearLayout>
