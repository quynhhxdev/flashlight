<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- Native Ad Content -->
    <FrameLayout
        android:id="@+id/nativeAdContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shimmer Loading -->
    <include
        android:id="@+id/shimmerContainerNative"
        layout="@layout/loading_native_fullscreen_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Close Button (top-right, hidden until countdown ends) -->
    <TextView
        android:id="@+id/tvClose"
        android:layout_width="wrap_content"
        android:layout_height="68dp"
        android:layout_gravity="top|end"
        android:background="@color/transparent"
        android:contentDescription="Close ad"
        android:gravity="center"
        android:minWidth="68dp"
        android:paddingHorizontal="12dp"
        android:text="Close in 3"
        android:textColor="#000000"
        android:textSize="14sp"
        android:visibility="gone" />

</FrameLayout>
