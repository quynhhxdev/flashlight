<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top|center_horizontal"
    android:background="#111111"
    android:paddingStart="16dp"
    android:paddingEnd="16dp">

    <!-- Icon container -->
    <FrameLayout
        android:layout_width="@dimen/_153dp"
        android:layout_height="162dp"
        android:layout_marginBottom="20dp"
        android:layout_marginTop="120dp">

        <ImageView
            android:id="@+id/ivNoInternet"
            android:layout_width="@dimen/_153dp"
            android:layout_height="162dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_no_internet"
            android:scaleType="fitCenter"
            android:contentDescription="No Internet" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvNoInternetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Oops, No Internet Connection"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:gravity="center"
        android:textStyle="normal" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvNoInternetDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Make sure wifi or cellular data is turned on\nand then try again."
        android:textColor="#A9A9A9"
        android:textSize="14sp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:lineSpacingExtra="2dp" />

    <!-- Go to Settings -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoToSettings"
        android:layout_width="match_parent"
        android:layout_height="49dp"
        android:layout_marginTop="20dp"
        android:text="Go to Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_yelllow_btn"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:padding="0dp" />

    <!-- Cancel -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cancel"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:textColor="#C1C7D0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="4dp" />

</LinearLayout>
