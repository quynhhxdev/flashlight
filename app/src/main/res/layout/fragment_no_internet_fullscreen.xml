<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- Icon container -->
    <FrameLayout
        android:id="@+id/iconContainer"
        android:layout_width="@dimen/_153dp"
        android:layout_height="162dp"
        android:layout_marginTop="120dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/ivNoInternet"
            android:layout_width="@dimen/_153dp"
            android:layout_height="162dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_no_internet"
            android:scaleType="fitCenter"
            android:contentDescription="No Internet" />

    </FrameLayout>

    <!-- Title -->
    <TextView
        android:id="@+id/tvNoInternetTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Oops, No Internet Connection"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintTop_toBottomOf="@id/iconContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Description -->
    <TextView
        android:id="@+id/tvNoInternetDescription"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="2dp"
        android:text="Make sure wifi or cellular data is turned on\nand then try again."
        android:textColor="#A9A9A9"
        android:textSize="14sp"
        android:fontFamily="@font/plus_jakarta_sans_regular"
        android:gravity="center"
        android:lineSpacingExtra="2dp"
        app:layout_constraintTop_toBottomOf="@id/tvNoInternetTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Go to Settings -->
    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/btnGoToSettings"
        android:layout_width="0dp"
        android:layout_height="49dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="20dp"
        android:text="Go to Settings"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textAllCaps="false"
        android:background="@drawable/bg_yelllow_btn"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintTop_toBottomOf="@id/tvNoInternetDescription"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Cancel -->
    <androidx.appcompat.widget.AppCompatTextView
        android:id="@+id/tvCancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Cancel"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        android:textColor="#C1C7D0"
        android:textSize="18sp"
        android:gravity="center"
        android:padding="4dp"
        app:layout_constraintTop_toBottomOf="@id/btnGoToSettings"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Banner Slot -->
    <FrameLayout
        android:id="@+id/bannerSlot"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <FrameLayout
            android:id="@+id/bannerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/shimmerContainerBanner"
            layout="@layout/layout_banner_control"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
