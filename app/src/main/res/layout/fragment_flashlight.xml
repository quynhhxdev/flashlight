<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- 1. Header Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/flashlight_title"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Main Circular Power Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnPower"
        android:layout_width="@dimen/_153dp"
        android:layout_height="@dimen/_153dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="80dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:id="@+id/powerBackground"
            android:layout_width="@dimen/_153dp"
            android:layout_height="@dimen/_153dp"
            android:background="#36394A"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPowerIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_flash_off"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvPowerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/power_off"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Modes Section (3 Tabs/Buttons) -->
    <LinearLayout
        android:id="@+id/layoutModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/btnPower">

        <!-- Mode 1: Flash Light (Active) -->
        <LinearLayout
            android:id="@+id/btnModeFlash"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_flash"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeFlash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_flash_mini"
                app:tint="@color/bg_yellow_switch" />

            <TextView
                android:id="@+id/tvModeFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_flash"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_yellow_switch"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mode 2: SOS Light -->
        <LinearLayout
            android:id="@+id/btnModeSos"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginEnd="12dp"
            android:layout_weight="1"
            android:background="@drawable/bg_no_internet_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeSos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sos"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvModeSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_sos"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mode 3: DJ Mode -->
        <LinearLayout
            android:id="@+id/btnModeDj"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_weight="1"
            android:background="@drawable/bg_no_internet_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeDj"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dj_mode"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvModeDj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/mode_dj"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Native Ad Container -->
    <FrameLayout
        android:id="@+id/nativeAdContainer"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/_16dp"
        android:layout_marginTop="@dimen/_48dp"
        android:background="@color/transparent"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutModes">

        <include
            android:id="@+id/shimmerContainerNative"
            layout="@layout/loading_native_ad_view_collapsible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
