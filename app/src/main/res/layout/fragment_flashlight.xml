<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111">

    <!-- 1. Header Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="Flashlight"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:fontFamily="@font/plus_jakarta_sans_semibold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- 2. Main Circular Power Button -->
    <androidx.cardview.widget.CardView
        android:id="@+id/btnPower"
        android:layout_width="@dimen/_153dp"
        android:layout_height="@dimen/_153dp"
        android:layout_marginTop="32dp"
        android:clickable="true"
        android:focusable="true"
        android:foreground="?attr/selectableItemBackgroundBorderless"
        app:cardCornerRadius="80dp"
        app:cardElevation="10dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle">

        <LinearLayout
            android:id="@+id/powerBackground"
            android:layout_width="@dimen/_153dp"
            android:layout_height="@dimen/_153dp"
            android:background="#36394A"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivPowerIcon"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:src="@drawable/ic_flash_off"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvPowerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="OFF"
                android:fontFamily="@font/plus_jakarta_sans_semibold"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="16sp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- 3. Modes Section (3 Tabs/Buttons) -->
    <LinearLayout
        android:id="@+id/layoutModes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="16dp"
        android:baselineAligned="false"
        android:orientation="horizontal"
        android:weightSum="3"
        app:layout_constraintTop_toBottomOf="@id/btnPower">

        <!-- Mode 1: Flash Light (Active) -->
        <LinearLayout
            android:id="@+id/btnModeFlash"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_btn_flash"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeFlash"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_flash_mini"
                app:tint="@color/bg_yellow_switch" />

            <TextView
                android:id="@+id/tvModeFlash"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Flash Light"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_yellow_switch"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mode 2: SOS Light -->
        <LinearLayout
            android:id="@+id/btnModeSos"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginHorizontal="4dp"
            android:layout_weight="1"
            android:background="@drawable/bg_no_internet_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeSos"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_sos"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvModeSos"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="SOS Light"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Mode 3: DJ Mode -->
        <LinearLayout
            android:id="@+id/btnModeDj"
            android:layout_width="0dp"
            android:layout_height="85dp"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_no_internet_card"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/ivModeDj"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_dj_mode"
                app:tint="@color/bg_no_select_btn" />

            <TextView
                android:id="@+id/tvModeDj"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="DJ Mode"
                android:fontFamily="@font/plus_jakarta_sans_medium"
                android:textColor="@color/bg_no_select_btn"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 4. Native Ad Container Card -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNativeAd"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="16dp"
        app:cardBackgroundColor="#1E232B"
        app:cardCornerRadius="16dp"
        app:cardElevation="2dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/layoutModes">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            tools:ignore="RtlSymmetry">

            <!-- Ad Attribution Tag -->
            <TextView
                android:id="@+id/tvAdTag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_yelllow_btn"
                android:paddingHorizontal="4dp"
                android:paddingVertical="1dp"
                android:text="Ad"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/tvAdHeadline"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="8dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="Test Ad: Flashlight App"
                android:textColor="#FFFFFF"
                android:textSize="12sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="@id/tvAdTag"
                app:layout_constraintEnd_toStartOf="@id/ivAdMedia"
                app:layout_constraintStart_toEndOf="@id/tvAdTag"
                app:layout_constraintTop_toTopOf="@id/tvAdTag" />

            <TextView
                android:id="@+id/tvAdRating"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="★★★★★"
                android:textColor="#FACC15"
                android:textSize="10sp"
                app:layout_constraintEnd_toEndOf="@id/tvAdHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAdTag" />

            <TextView
                android:id="@+id/tvAdBody"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:ellipsize="end"
                android:maxLines="3"
                android:text="Brightest flashlight LED light for your device!"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="@id/tvAdHeadline"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAdRating" />

            <!-- Media Image Preview -->
            <androidx.cardview.widget.CardView
                android:id="@+id/ivAdMedia"
                android:layout_width="160dp"
                android:layout_height="90dp"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bg_yelllow_btn" />
            </androidx.cardview.widget.CardView>

            <!-- Call-To-Action Button -->
            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnAdCta"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_yelllow_btn"
                android:text="Install"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintTop_toBottomOf="@id/ivAdMedia" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>
