<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outer shadow layer 1 (Soft blur glow ~ 13.85px #FFD54F26) -->
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="17dp" />
            <solid android:color="#04FFD54F" />
        </shape>
    </item>

    <!-- Outer shadow layer 2 -->
    <item
        android:bottom="2dp"
        android:left="2dp"
        android:right="2dp"
        android:top="2dp">
        <shape android:shape="rectangle">
            <corners android:radius="15.5dp" />
            <solid android:color="#06FFD54F" />
        </shape>
    </item>

    <!-- Mid shadow layer 3 -->
    <item
        android:bottom="4dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="14dp" />
            <solid android:color="#0AFFD54F" />
        </shape>
    </item>

    <!-- Inner shadow layer 4 (#FFD54F26 -> #26FFD54F) -->
    <item
        android:bottom="5.5dp"
        android:left="5.5dp"
        android:right="5.5dp"
        android:top="5.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="12.5dp" />
            <solid android:color="#10FFD54F" />
        </shape>
    </item>

    <!-- Main Button Solid Fill & Stroke -->
    <item
        android:bottom="6.5dp"
        android:left="6.5dp"
        android:right="6.5dp"
        android:top="6.5dp">
        <shape android:shape="rectangle">
            <corners android:radius="11dp" />
            <solid android:color="@color/yellow_bg_btn_navigation" />
        </shape>
    </item>

</layer-list>
