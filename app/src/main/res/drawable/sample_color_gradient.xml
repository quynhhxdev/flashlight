<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Lớp 1: Chuyển sắc ngang từ Trắng sang Màu chủ đạo -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:endColor="#9751F2"
                android:startColor="#FFFFFF"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>

    <!-- Lớp 2: Phủ bóng dọc từ Trong suốt xuống Đen -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:angle="270"
                android:endColor="#FF000000"
                android:startColor="#00000000"
                android:type="linear" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</layer-list>