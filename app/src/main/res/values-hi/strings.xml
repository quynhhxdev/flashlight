    <!-- Rating Dialog Strings -->
    <string name="rating_title_default">क्या आपको "%1$s" पसंद है?</string>
    <string name="rating_desc_default">आपकी प्रतिक्रिया हमें बेहतर बनाने में मदद करती है। कृपया अपने अनुभव को रेट करने के लिए थोड़ा समय दें।</string>
    <string name="rating_title_1">ओह नहीं! यह सुनकर हमें दुख हुआ।</string>
    <string name="rating_desc_1">आपकी प्रतिक्रिया हमारे लिए सुधार करने में बहुत महत्वपूर्ण है। क्या आप बता सकते हैं कि क्या गलत हुआ?</string>
    <string name="rating_title_2">यह तो दुखद है!</string>
    <string name="rating_desc_2">आप हमें 5-स्टार रेटिंग देने के लिए क्या बेहतर कर सकते हैं?</string>
    <string name="rating_title_3">आपकी प्रतिक्रिया के लिए धन्यवाद!</string>
    <string name="rating_desc_3">हम जानना चाहेंगे कि हम आपका अनुभव कैसे बेहतर बना सकते हैं।</string>
    <string name="rating_title_4">आपके समर्थन के लिए धन्यवाद!</string>
    <string name="rating_desc_4">हमें खुशी है कि आप ऐप का आनंद ले रहे हैं! सार्वजनिक समीक्षाएँ हमें आगे बढ़ने में मदद करती हैं।</string>
    <string name="rating_title_5">शानदार! आपने हमारा दिन बना दिया!</string>
    <string name="rating_desc_5">आपकी संतुष्टि हमारी सारी मेहनत को सार्थक बनाती है।</string>
